<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cr.una.proyecto1</groupId>
    <artifactId>sistema-reservas</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!--
    POM padre del Proyecto 2. La aplicacion se parte en tres modulos para que la
    arquitectura distribuida que exige el enunciado sea verificable y no solo una
    promesa:

      common   - Model, excepciones y (desde el paso 3) IService y el protocolo.
                 No depende de NADA.
      backend  - capas Logica y Datos. Es el unico que puede tocar la base de
                 datos. Depende de common.
      frontend - capa de Presentacion (MVC) y los reportes PDF. Depende de
                 common. NO debe tener ninguna referencia a la base de datos:
                 eso se comprueba con
                     mvn -pl frontend dependency:tree
                 que no debe mencionar ningun driver JDBC.
    -->

    <modules>
        <module>common</module>
        <module>backend</module>
        <module>frontend</module>
    </modules>

    <properties>
        <maven.compiler.source>20</maven.compiler.source>
        <maven.compiler.target>20</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <junit.version>5.11.0</junit.version>
        <!-- Coincide con la version de Jaspersoft Studio Community que se instale
             (6.20.6, la disponible sin cuenta de TIBCO via el mirror de SourceForge). -->
        <jasperreports.version>6.20.6</jasperreports.version>
        <!-- Usada por Service.AIReservationExtractionService para construir el
             cuerpo JSON de las llamadas a la API de IA (reservas por lenguaje natural). -->
        <json.version>20251224</json.version>
        <!-- Driver JDBC de Oracle, usado SOLO por el modulo backend.
             ojdbc11 esta compilado para JDK 11 en adelante, asi que sirve con el
             JDK de este proyecto. Si Maven no resuelve esta version, la anterior
             conocida es 23.4.0.24.05. -->
        <oracle.jdbc.version>23.26.0.0.0</oracle.jdbc.version>
    </properties>

    <!--
    dependencyManagement fija las versiones en un solo lugar; cada modulo declara
    solo el groupId/artifactId de lo que realmente usa.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>cr.una.proyecto1</groupId>
                <artifactId>sistema-reservas-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>cr.una.proyecto1</groupId>
                <artifactId>sistema-reservas-backend</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>net.sf.jasperreports</groupId>
                <artifactId>jasperreports</artifactId>
                <version>${jasperreports.version}</version>
            </dependency>
            <dependency>
                <groupId>org.json</groupId>
                <artifactId>json</artifactId>
                <version>${json.version}</version>
            </dependency>
            <!-- La version se fija aqui; quien la declara como dependencia real es
                 unicamente backend/pom.xml. Tenerla en dependencyManagement NO la
                 agrega a ningun modulo: solo dice que version usar si alguien la pide. -->
            <dependency>
                <groupId>com.oracle.database.jdbc</groupId>
                <artifactId>ojdbc11</artifactId>
                <version>${oracle.jdbc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Todos los modulos pueden escribir pruebas. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Pruebas unitarias: *Test.java -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <!-- Pruebas de integracion: *IT.java -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.2.5</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
