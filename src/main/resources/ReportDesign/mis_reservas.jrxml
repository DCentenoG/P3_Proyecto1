<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="mis_reservas" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <parameter name="employeeName" class="java.lang.String" isForPrompting="false"/>

    <field name="activity" class="java.lang.String"/>
    <field name="date" class="java.lang.String"/>
    <field name="timeRange" class="java.lang.String"/>
    <field name="resources" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>

    <title>
        <band height="65">
            <staticText>
                <reportElement x="0" y="0" width="535" height="30"/>
                <textElement>
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Mis Reservas]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="30" width="400" height="15"/>
                <textElement>
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Funcionario: " + $P{employeeName}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="0" y="47" width="535" height="15"/>
                <textElement textAlignment="Right">
                    <font size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="110" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Actividad]]></text>
            </staticText>
            <staticText>
                <reportElement x="110" y="0" width="70" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Fecha]]></text>
            </staticText>
            <staticText>
                <reportElement x="180" y="0" width="90" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Hora]]></text>
            </staticText>
            <staticText>
                <reportElement x="270" y="0" width="185" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Recursos]]></text>
            </staticText>
            <staticText>
                <reportElement x="455" y="0" width="80" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Estado]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="110" height="18"/>
                <textFieldExpression><![CDATA[$F{activity}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="110" y="0" width="70" height="18"/>
                <textFieldExpression><![CDATA[$F{date}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="180" y="0" width="90" height="18"/>
                <textFieldExpression><![CDATA[$F{timeRange}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="270" y="0" width="185" height="18"/>
                <textFieldExpression><![CDATA[$F{resources}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="455" y="0" width="80" height="18"/>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="450" y="0" width="85" height="15"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
